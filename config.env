# Shared settings, sourced by scripts/run_bench.sh and read by bench.py for the
# `image` column. Every value is `${NAME:-default}` so the environment wins
# (llama-intel-arc-b70's config.env explains why).

# The engine under test: LocalAI v4.11.0 (58830f7) with Louise's patch series
# on its llama.cpp backend (P1 + P2, series digest 724329e027f2), built for
# gfx1200 with louise-rag's deploy/localai/llama-cpp/build.sh hipblas, run in
# Docker Desktop over /dev/dxg with librocdxg 1.2.2 (louise-localai:rocm).
IMAGE="${IMAGE:-localai-v4.11.0+louise-llama-cpp:hipblas-724329e027f2}"

# LocalAI on this PC (deploy/localai-desktop in louise-rag).
URL="${URL:-http://127.0.0.1:30286}"
HEALTH_PATH="${HEALTH_PATH:-/readyz}"
EMBED_MODEL="${EMBED_MODEL:-bench-qwen3-embedding-8b}"
# LocalAI's models directory as the host sees it: the bench model's YAML is
# copied in for a run and removed after.
MODELS_DIR="${MODELS_DIR:-/d/louise-rag/deploy/localai-desktop/models}"
LOCALAI_CONTAINER="${LOCALAI_CONTAINER:-louise-localai-localai-1}"

# The B70's comparable rows (llama-intel-arc-b70/baselines/history.csv,
# 2026-08-27): Qwen3-Embedding-8B Q4_K_M, -c 8192 -np 1 -b 8192 -ub 8192,
# flash attention on, GGML_SYCL_ENABLE_DNN=0, bench pool, 3 passes —
# 3,202 tok/s at client concurrency 2 (LIVE), 3,192 at 4.
CONCURRENCY="${CONCURRENCY:-1 2 4}"
PASSES="${PASSES:-3}"

# Pools, byte-identical to the B70 repo's at a2dae24 (sha256 in README.md).
FIXTURES="${FIXTURES:-fixtures/chunks.json}"
BENCH_FIXTURES="${BENCH_FIXTURES:-fixtures/bench.json}"
